{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/jobs/trial-campaign",
      "schedule": "0 * * * *"
    },
    {
      "path": "/jobs/nutrition",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/jobs/retention",
      "schedule": "0 22 * * 0"
    }
  ]
}
