APP_NAME=Victory Fitness API
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_BASE_URL=http://localhost:8000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB=victory_fitness

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
SESSION_TOKEN_EXPIRE_DAYS=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Victory Fitness
SMTP_USE_TLS=true

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.5
OPENAI_MEAL_ANALYSIS_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
VIMEO_ACCESS_TOKEN=


AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PREFIX=coach-archives

FRONTEND_ORIGIN=http://localhost:8081
FRONTEND_ORIGIN_REGEX=.*
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

ADMIN_SEED_ENABLED=true
ADMIN_NAME=Victory Admin
ADMIN_EMAIL=admin@victoryfitness.com
ADMIN_PASSWORD=Admin@123456

WEARABLE_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
WEARABLE_SCHEDULER_ENABLED=true
WEARABLE_SCHEDULER_INTERVAL_MINUTES=30
WEARABLE_SCHEDULER_LOOKBACK_DAYS=1

FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:8000/wearables/fitbit/callback
FITBIT_SCOPES=activity,heartrate,sleep,profile

GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://localhost:8000/wearables/garmin/callback
GARMIN_AUTHORIZE_URL=
GARMIN_TOKEN_URL=
GARMIN_API_BASE_URL=
GARMIN_DAILY_SUMMARY_PATH=/wellness-api/rest/dailies
GARMIN_SCOPES=
GARMIN_WEBHOOK_SECRET=
