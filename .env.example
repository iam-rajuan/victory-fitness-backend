APP_NAME=Victory Fitness API
ENVIRONMENT=development

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB=victory_fitness

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
SESSION_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=https://victory-fitness-app.vercel.app,https://victora-web-app.vercel.app,https://victory-fitness-dashboard.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:8081
CORS_ALLOW_ALL=false
COOKIE_SECURE=true
COOKIE_SAMESITE=none

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=Victory Fitness
SMTP_USE_TLS=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MEAL_ANALYSIS_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

VIMEO_ACCESS_TOKEN=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PREFIX=coach-archives

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com

ADMIN_SEED_ENABLED=true
ADMIN_NAME=Victory Admin
ADMIN_EMAIL=admin@victoryfitness.com
ADMIN_PASSWORD=change-this-admin-password
