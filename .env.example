APP_NAME=Victory Fitness API
APP_URL=http://localhost:8081
API_URL=http://localhost:8000
NODE_ENV=development
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_BASE_URL=http://localhost:8000

DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=<app-name>
MONGODB_URI=${DATABASE_URL}
MONGODB_DB=victory_fitness
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-this-in-production
JWT_SECRET_KEY=change-this-in-production
SESSION_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
SESSION_TOKEN_EXPIRE_DAYS=30

ENCRYPTION_KEY=replace-with-a-long-random-secret
WEARABLE_TOKEN_ENCRYPTION_KEY=${ENCRYPTION_KEY}
HEALTH_NATIVE_UPLOAD_SECRET=
WEBHOOK_SIGNING_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Victory Fitness
SMTP_USE_TLS=true

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.5
OPENAI_MEAL_ANALYSIS_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
VIMEO_ACCESS_TOKEN=

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PREFIX=coach-archives

FRONTEND_ORIGINS=http://localhost:8081,http://localhost:5173,https://victory-fitness-app.vercel.app
FRONTEND_ORIGIN=http://localhost:8081
FRONTEND_ORIGIN_REGEX=
CORS_ORIGIN=https://victory-fitness-app.vercel.app
COOKIE_SECURE=true
COOKIE_SAMESITE=none

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com

ADMIN_SEED_ENABLED=true
ADMIN_NAME=Victory Admin
ADMIN_EMAIL=admin@victoryfitness.com
ADMIN_PASSWORD=Admin@123456

WEARABLE_SCHEDULER_ENABLED=true
WEARABLE_SCHEDULER_INTERVAL_MINUTES=30
WEARABLE_SCHEDULER_LOOKBACK_DAYS=1
SYNC_QUEUE_CONCURRENCY=5
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_BACKOFF_MS=5000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
