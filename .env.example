APP_NAME=Victory Fitness API
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB=victory_fitness

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10
SESSION_TOKEN_EXPIRE_DAYS=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Victory Fitness
SMTP_USE_TLS=true

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001


AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PREFIX=coach-archives

FRONTEND_ORIGIN=http://localhost:8081
FRONTEND_ORIGIN_REGEX=.*
COOKIE_SECURE=false

ADMIN_SEED_ENABLED=true
ADMIN_NAME=Victory Admin
ADMIN_EMAIL=admin@victoryfitness.com
ADMIN_PASSWORD=Admin@123456
