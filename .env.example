APP_NAME=Victory Fitness API
ENVIRONMENT=development

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB=victory_fitness

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_TOKEN_EXPIRE_DAYS=1

CORS_ORIGINS=https://victory-fitness-app.vercel.app,https://victora-web-app.vercel.app,https://victory-fitness-dashboard.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:8081
# Optional: override if you want a custom preview-domain rule.
# The default code already allows trusted *.vercel.app previews for the
# Victory Fitness frontend and dashboard projects.
# CORS_ORIGIN_REGEX=^https://(victory-fitness-dashboard|victory-fitness-app|victora-web-app|victory-fitness-backend)(?:-[a-z0-9-]+)*\.vercel\.app$
CORS_ALLOW_ALL=false
COOKIE_SECURE=true
COOKIE_SAMESITE=none

RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=Victory Fitness <noreply@victoryfitness.de>

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MEAL_ANALYSIS_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

VIMEO_ACCESS_TOKEN=

STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=eur
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:8081/plan?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:8081/plan?checkout=cancelled

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PREFIX=coach-archives

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# GOOGLE_REDIRECT_URI=https://victory-fitness-backend.onrender.com/auth/google/callback
# GOOGLE_REDIRECT_URI=https://api.victoryfitnessapp.com/auth/google/callback
GOOGLE_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional alternative: the complete service-account JSON as one environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com

ADMIN_SEED_ENABLED=true
ADMIN_EMAIL_Primary=office@victoryfitness.de
ADMIN_PASSWORD_Primary=change-this-primary-admin-password
ADMIN_EMAIL_DEV=developer@example.com
ADMIN_PASSWORD_DEV=change-this-dev-admin-password

CRON_SECRET=
AI_GENERATION_JOB_CONCURRENCY=10
AI_GENERATION_TIMEOUT_SECONDS=30
PUSH_NOTIFICATION_CONCURRENCY=50
WEEKLY_DIGEST_CRON_UTC=0 22 * * 0

FEATURE_FLAGS_PROVIDER=growthbook
GROWTHBOOK_API_HOST=
GROWTHBOOK_CLIENT_KEY=

POSTHOG_API_HOST=https://app.posthog.com
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

PLAUSIBLE_API_HOST=https://plausible.io
PLAUSIBLE_DOMAIN=
PLAUSIBLE_API_KEY=
REQUEST_ANALYTICS_ENABLED=true

SENTRY_DSN=
OTEL_SERVICE_NAME=victory-fitness-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

GCP_PRIMARY_REGION=europe-west1
GCP_SECONDARY_REGIONS=asia-south1,us-central1

CLOUDFLARE_ZONE=
CLOUDFLARE_ZERO_TRUST_AUD=
TRUSTED_PROXY_HEADER=CF-Connecting-IP
